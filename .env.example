# Copy to .env and choose a unique 12–1024 character administrator password.
CHATBOX_ADMIN_PASSWORD=
# Exact browser origin, no trailing slash. Remote production MUST use HTTPS.
CHATBOX_PUBLIC_ORIGIN=http://127.0.0.1:1212
# Host listening port. The example binds only to loopback for local/TLS proxy use.
CHATBOX_WEB_PORT=1212
# Explicitly allow ordinary registration. admin is always reserved.
CHATBOX_SYNC_REGISTRATION=1