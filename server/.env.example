# Copy to .env (ignored by Git), choose a unique password of 12–1024 characters.
# Never commit or share the real .env. Restart the backend after changing it.
# Blank/unset disables admin login; there is no default password.
CHATBOX_ADMIN_PASSWORD=

# Listening port; localhost HTTP only. Linux Compose uses host networking.
CHATBOX_SERVER_PORT=4567

# Local registration defaults to enabled; remote TLS deployments default off.
# CHATBOX_SYNC_REGISTRATION=1

# Remote production: terminate TLS at a reverse proxy running on this Linux host.
# Preserve Host, OVERWRITE X-Forwarded-Proto=https, allow request bodies >= 2 MiB.
# Exact proxy socket IPs only (not CIDR or wildcard). Enable BOTH values below.
# CHATBOX_SYNC_PROXY_PEERS=127.0.0.1
# CHATBOX_SYNC_HOSTS=sync.example.com
# Optional browser client CORS origins (HTTPS only remotely), comma-separated.
# CHATBOX_SYNC_ORIGINS=https://chat.example.com,null